# Local development only. Change passwords before exposing any service.
POSTGRES_PASSWORD=local-admin-only
APP_DB_PASSWORD=local-runtime-only
DATABASE_URL=postgresql+psycopg://rag_app:local-runtime-only@localhost:5432/rag
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:local-admin-only@localhost:5432/rag
CORS_ORIGINS=["http://localhost:3000"]
# Public hostname served by caddy over HTTPS. Leave as localhost for a self-signed
# local certificate; set a real domain that resolves to this server for Let's Encrypt.
DOMAIN=localhost

# Local Ollama defaults. For any OpenAI-compatible server (LM Studio, vLLM, OpenAI
# itself) set both providers to openai_compatible, end the base URL with /v1, and
# give a non-empty API key — LM Studio ignores the value but the factory requires one.
# From Docker on WSL2 the Windows host is the eth0 gateway (ip route show default),
# not host.docker.internal.
CHAT_PROVIDER=ollama
CHAT_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=llama3.2
CHAT_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=
# Optional reranker: set API_EXTRAS=rerank and RERANKER_MODEL=BAAI/bge-reranker-base (about 1 GB,
# downloaded on first start into ./data/models), then rebuild the api image. Adds CPU time per answer.
# Optional Langfuse tracing: add `trace` to API_EXTRAS (comma-separated, e.g. rerank,trace), set both
# keys and rebuild. Every question and answer is sent to LANGFUSE_HOST, including widget visitors',
# so use your own Langfuse deployment (or accept the cloud's terms) before enabling it.
# Optional query rewriting: the chat model rewrites each question into a search query and both
# wordings are searched. One extra model call per question; off unless it measurably helps your data.
QUERY_REWRITE=false
# How long a dashboard sign-in lasts, in hours. Users are created with `python -m rag.users add`.
SESSION_HOURS=12
API_EXTRAS=
RERANKER_MODEL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
STORAGE_ROOT=data/uploads
UPLOAD_MAX_BYTES=20971520
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
INGESTION_MAX_CHUNKS=2000
EMBEDDING_BATCH_SIZE=32
INGESTION_LEASE_SECONDS=900
